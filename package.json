{
  "name": "videoclub-api-nestjs-ts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Incremental VideoClub REST API built with NestJS and TypeScript",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.0",
    "@nestjs/core": "^12.0.0",
    "@nestjs/platform-express": "^12.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/testing": "^12.0.0",
    "@types/node": "^24.0.0",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.1.3",
    "tsx": "^4.20.6",
    "typescript": "^6.0.0",
    "vitest": "^4.0.0"
  }
}
